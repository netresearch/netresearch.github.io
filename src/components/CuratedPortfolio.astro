---
import type { Lang } from '../i18n';
import { path } from '../i18n';
import { useContent } from '../i18n/content';
import type { CuratedProject } from '../data/load-curated';

interface Props {
  lang: Lang;
  projects: CuratedProject[];
}

const { lang, projects } = Astro.props;
const t = useContent(lang);

const facets = [{ id: 'all', label: t.portfolio.allLabel }, ...t.portfolio.facets];
---

<section id="portfolio" class="py-20 border-t border-border bg-surface-alt" aria-labelledby="portfolio-heading">
  <div class="max-w-7xl mx-auto px-6">
    <h2 id="portfolio-heading" class="font-heading font-black text-3xl md:text-4xl text-text-primary">
      {t.portfolio.heading}
    </h2>
    <p class="mt-3 text-text-secondary max-w-3xl">{t.portfolio.intro}</p>

    <!--
      Every card is in the initial HTML. The filter only sets `hidden` on cards
      that do not match, so no project is reachable through JavaScript alone.
    -->
    <div class="mt-8" role="group" aria-label={t.portfolio.filterLabel}>
      <div class="flex flex-wrap gap-2">
        {
          facets.map((facet, index) => (
            <button
              type="button"
              data-facet={facet.id}
              aria-pressed={index === 0 ? 'true' : 'false'}
              class="portfolio-filter min-h-[44px] px-4 rounded-lg border border-border text-sm font-heading font-semibold text-text-secondary hover:border-nr-teal hover:text-nr-teal transition-colors aria-pressed:bg-nr-teal aria-pressed:text-white aria-pressed:border-nr-teal"
            >
              {facet.label}
            </button>
          ))
        }
      </div>
    </div>

    <ul id="portfolio-list" class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <li
            id={`repo-${project.repo}`}
            data-facet={project.facet}
            class="rounded-xl border border-border bg-surface-card p-5 card-shadow flex flex-col"
          >
            <h3 class="font-heading font-bold text-lg text-text-primary">
              <a href={project.url} class="hover:text-nr-teal transition-colors" rel="noopener">
                {project.repo}
              </a>
            </h3>
            <p class="mt-2 text-sm text-text-secondary flex-1">{project.problem[lang]}</p>
            <dl class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-muted">
              {project.latestRelease && (
                <div class="flex gap-1">
                  <dt>{t.portfolio.releaseLabel}:</dt>
                  <dd class="font-semibold text-text-secondary">{project.latestRelease}</dd>
                </div>
              )}
              {project.language && (
                <div class="flex gap-1">
                  <dt class="sr-only">Language</dt>
                  <dd>{project.language}</dd>
                </div>
              )}
              <div class="flex gap-1">
                <dt class="sr-only">{t.portfolio.starsLabel}</dt>
                <dd>{project.stars} &#9733;</dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>

    <p id="portfolio-empty" hidden class="mt-6 text-text-secondary">{t.catalogue.emptyLabel}</p>

    <p class="mt-8">
      <a
        href={path('projects', lang)}
        class="inline-flex items-center gap-2 min-h-[44px] font-heading font-semibold text-nr-teal hover:text-nr-teal/80 transition-colors"
      >
        {t.portfolio.catalogueLink}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('.portfolio-filter');
    var cards = document.querySelectorAll('#portfolio-list > li');
    var empty = document.getElementById('portfolio-empty');
    if (!buttons.length || !cards.length) return;

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var facet = button.dataset.facet;
        buttons.forEach(function (other) {
          other.setAttribute('aria-pressed', String(other === button));
        });
        var visible = 0;
        cards.forEach(function (card) {
          var match = facet === 'all' || card.dataset.facet === facet;
          card.hidden = !match;
          if (match) visible += 1;
        });
        if (empty) empty.hidden = visible !== 0;
      });
    });
  })();
</script>
