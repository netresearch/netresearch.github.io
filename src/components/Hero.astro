---
import type { Lang } from '../i18n';
import { useContent } from '../i18n/content';
import { site } from '../data/site';
import CtaPair from './CtaPair.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useContent(lang);
---

<section class="nr-hero" data-nr-hero>
  <div class="nr-hero-inner">
    <div class="nr-hero-content">
    <p class="nr-hero-eyebrow">Netresearch · Open Source</p>
    <h1 class="nr-hero-title">
      {t.hero.headline}
    </h1>
    <p class="nr-hero-lead">
      {t.hero.sub}
    </p>
      <CtaPair
        class="nr-hero-actions"
        lang={lang}
        campaign={site.utmCampaign}
        position="hero"
        businessLabel={t.hero.secondaryCta}
        technicalLabel={t.hero.primaryCta}
        technicalHref="#ai-stack"
      />
    </div>
  </div>
</section>
