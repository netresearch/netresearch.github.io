---
import type { Lang, RouteKey } from '../i18n';
import { contactUrl, path } from '../i18n';
import { useContent } from '../i18n/content';
import { site } from '../data/site';
import { renderSiteHeader, renderPageNavigation } from '../../shared/site-shell/render-site-shell.mjs';
import headerTemplate from '../../shared/site-shell/site-shell.html?raw';
import pageNavigationTemplate from '../../shared/site-shell/page-navigation.html?raw';

interface Props {
  lang: Lang;
  /** Keep language switches on the corresponding page. */
  route: RouteKey;
}

const { lang, route } = Astro.props as Props;
const t = useContent(lang);
const header = renderSiteHeader({
  lang,
  assetBase: '/assets/site-shell',
  languageUrls: { de: path(route, 'de'), en: path(route, 'en') },
  active: route,
  contactHref: contactUrl(lang, site.utmCampaign, 'nav'),
}, headerTemplate);
const localNavigation = route === 'home' ? renderPageNavigation({
  lang,
  title: 'Open Source',
  links: [
    { href: '#ai-stack', label: t.nav.aiStack },
    { href: '#impact', label: t.nav.impact },
    { href: '#portfolio', label: t.nav.projects },
  ],
}, pageNavigationTemplate) : '';
---

<Fragment set:html={header} />
<Fragment set:html={localNavigation} />
