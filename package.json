    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.2.2",
    "js-yaml": "^5.3.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-yaml": "^4.0.9",
    "axe-core": "^4.13.0",
    "puppeteer": "^25.7.0",
    "typescript": "^6.0.3"
  }
