{
  "name": "netresearch-github-io",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "fetch-repos": "node scripts/fetch-repos.mjs",
    "fetch-data": "node scripts/fetch-repos.mjs && node scripts/build-manifest.mjs && node scripts/fetch-impact.mjs",
    "build-manifest": "node scripts/build-manifest.mjs",
    "fetch-impact": "node scripts/fetch-impact.mjs",
    "build-og-image": "node scripts/build-og-image.mjs",
    "verify": "node scripts/verify-site.mjs && node scripts/axe-audit.mjs",
